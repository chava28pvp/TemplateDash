    WITH base AS (
        SELECT
            `Technology` AS technology,
            `Vendor` AS vendor,
            `Noc_Cluster` AS noc_cluster,
            `Network`  AS network,
            `PS_RRC_%IA`, `PS_RAB_%IA`, `PS_S1_%IA`, `PS_DROP_%DC`, `CS_RRC_%IA`, `CS_RAB_%IA`, `CS_DROP_%DC`
        FROM `Dashboard_Master`
        WHERE (1=1) AND `Date` IN (?, ?)
    ),
    flags_raw AS (
        SELECT
            technology, vendor, noc_cluster, network,
            (CASE WHEN network = ? AND COALESCE(CAST(`PS_RRC_%IA` AS REAL), 0) >= ? THEN 1 ELSE (CASE WHEN COALESCE(CAST(`PS_RRC_%IA` AS REAL), 0) >= ? THEN 1 ELSE 0 END) END) AS f_ps_rrc_ia_percent,
            (CASE WHEN COALESCE(CAST(`PS_RAB_%IA` AS REAL), 0) >= ? THEN 1 ELSE 0 END) AS f_ps_rab_ia_percent,
            (CASE WHEN COALESCE(CAST(`PS_S1_%IA` AS REAL), 0) >= ? THEN 1 ELSE 0 END) AS f_ps_s1_ia_percent,
            (CASE WHEN COALESCE(CAST(`PS_DROP_%DC` AS REAL), 0) >= ? THEN 1 ELSE 0 END) AS f_ps_drop_dc_percent,
            (CASE WHEN network = ? AND COALESCE(CAST(`CS_RRC_%IA` AS REAL), 0) >= ? THEN 1 WHEN network = ? AND COALESCE(CAST(`CS_RRC_%IA` AS REAL), 0) >= ? THEN 1 ELSE (CASE WHEN COALESCE(CAST(`CS_RRC_%IA` AS REAL), 0) >= ? THEN 1 ELSE 0 END) END) AS f_cs_rrc_ia_percent,
            (CASE WHEN COALESCE(CAST(`CS_RAB_%IA` AS REAL), 0) >= ? THEN 1 ELSE 0 END) AS f_cs_rab_ia_percent,
            (CASE WHEN COALESCE(CAST(`CS_DROP_%DC` AS REAL), 0) >= ? THEN 1 ELSE 0 END) AS f_cs_drop_dc_percent
        FROM base
    ),
    flags AS (
        SELECT
            fr.*,
            (COALESCE(f_ps_rrc_ia_percent,0) + COALESCE(f_ps_rab_ia_percent,0) + COALESCE(f_ps_s1_ia_percent,0) + COALESCE(f_ps_drop_dc_percent,0) + COALESCE(f_cs_rrc_ia_percent,0) + COALESCE(f_cs_rab_ia_percent,0) + COALESCE(f_cs_drop_dc_percent,0)) AS row_flag_sum
        FROM flags_raw fr
    ),
    agg_trio AS (
